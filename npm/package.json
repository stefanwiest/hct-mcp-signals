{
    "name": "@hct/mcp-signals",
    "version": "0.1.0",
    "description": "HCT Coordination Signals Extension for MCP - Adds urgency, timing, and approval semantics",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc && tsc -p tsconfig.esm.json",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build && npm test"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "agents",
        "coordination",
        "hct",
        "multi-agent",
        "signals"
    ],
    "author": "Stefan Wiest <mail@stefanwiest.de>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/stefanwiest/hct-mcp-signals.git"
    },
    "bugs": {
        "url": "https://github.com/stefanwiest/hct-mcp-signals/issues"
    },
    "homepage": "https://github.com/stefanwiest/hct-mcp-signals#readme",
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.0",
        "typescript": "^5.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}